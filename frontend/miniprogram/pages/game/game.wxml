<view class="game-page">
  <view class="status-bar">
    <view class="back-btn" bindtap="onBack">←</view>
    <view class="help-btn">?</view>
    <view class="piggy-icon">🐷</view>
  </view>

  <!-- 断线重连遮罩 -->
  <view class="lock-overlay" wx:if="{{showReconnecting}}">
    <view class="lock-spinner"></view>
    <text>{{reconnectText}}</text>
  </view>

  <view class="lobby-stage" wx:if="{{!gameStarted && !showReconnecting}}">
    <view class="table-title">升级 · 四人桌</view>
    
    <view class="table-center">
      <!-- 北 - 玩家3 (index 2) -->
      <view class="player-seat seat-top" wx:if="{{roomPlayers[2]}}">
        <view class="seat-avatar">
          <text class="avatar-letter" style="text-transform: uppercase;">{{roomPlayers[2].initial || '?'}}</text>
        </view>
        <view class="seat-name">{{roomPlayers[2].nickname || roomPlayers[2].name}}</view>
        <view class="seat-status {{roomPlayers[2].ready ? 'ready' : 'waiting'}}">{{roomPlayers[2].ready ? '✓已准备' : '等待中'}}</view>
        <view class="seat-cards">{{p2Count}}张</view>
      </view>
      
      <!-- 西 - 玩家4 (index 3) -->
      <view class="player-seat seat-left" wx:if="{{roomPlayers[3]}}">
        <view class="seat-avatar">
          <text class="avatar-letter" style="text-transform: uppercase;">{{roomPlayers[3].initial || '?'}}</text>
        </view>
        <view class="seat-name">{{roomPlayers[3].nickname || roomPlayers[3].name}}</view>
        <view class="seat-status {{roomPlayers[3].ready ? 'ready' : 'waiting'}}">{{roomPlayers[3].ready ? '✓已准备' : '等待中'}}</view>
        <view class="seat-cards">{{p3Count}}张</view>
      </view>
      
      <!-- 东 - 玩家1 (index 1) -->
      <view class="player-seat seat-right" wx:if="{{roomPlayers[1]}}">
        <view class="seat-avatar">
          <text class="avatar-letter" style="text-transform: uppercase;">{{roomPlayers[1].initial || '?'}}</text>
        </view>
        <view class="seat-name">{{roomPlayers[1].nickname || roomPlayers[1].name}}</view>
        <view class="seat-status {{roomPlayers[1].ready ? 'ready' : 'waiting'}}">{{roomPlayers[1].ready ? '✓已准备' : '等待中'}}</view>
        <view class="seat-cards">{{p1Count}}张</view>
      </view>
      
      <!-- 南 - 自己 (myIndex) -->
      <view class="player-seat seat-bottom self-seat">
        <view class="seat-avatar self-avatar">
          <text class="avatar-letter" style="text-transform: uppercase;">{{roomPlayers[myIndex] ? (roomPlayers[myIndex].initial || '?') : '我'}}</text>
        </view>
        <view class="seat-name self-name">{{roomPlayers[myIndex] ? (roomPlayers[myIndex].nickname || roomPlayers[myIndex].name) : '我'}}</view>
        <view class="seat-status ready">✓已准备</view>
      </view>
    </view>
    
    <view class="center-buttons">
      <button class="action-btn ready-btn {{selfReady ? 'active' : ''}}" bindtap="onSelfReady">
        {{selfReady ? '✓已准备' : '准备'}}
      </button>
      <button class="action-btn start-btn {{allReady && roomPlayerCount === 4 ? 'active' : ''}}" bindtap="onDealCards" wx:if="{{allReady && roomPlayerCount === 4}}">
        开始发牌
      </button>
    </view>
  </view>

  <view class="game-stage" wx:if="{{gameStarted}}">
    <!-- 顶部信息条：左上记分面板 + 右侧亮主区（横向 6 chip 小条） -->
    <view class="top-bar">
      <view class="score-panel">
        <view class="score-row">
          <text class="score-team mine">我方 {{scorePanel.myLevel}}级</text>
          <text class="score-team opp">对方 {{scorePanel.oppLevel}}级</text>
        </view>
        <view class="score-row">
          <text class="score-points mine">本轮 {{scorePanel.myScore}}分</text>
          <text class="score-points opp">对方 {{scorePanel.oppScore}}分</text>
        </view>
        <view class="score-row trump-info">
          <text class="trump-info-text">本局打:{{scorePanel.trumpText}}</text>
        </view>
      </view>

      <!-- 顶部右侧：6 chip 横排 + caption。chip 可点击亮主叫分 -->
      <view class="trump-display" wx:if="{{trumpDisplayVisible}}">
        <view class="trump-chips">
          <view class="trump-chip {{item.lit ? 'lit' : ''}} {{item.dim ? 'dim' : ''}} {{item.suitClass}} {{item.clickable ? 'clickable' : ''}}"
                wx:for="{{trumpChips}}" wx:key="key"
                data-suit="{{item.key}}" data-bid="0"
                bindtap="onTrumpChipTap">
            <text class="chip-label">{{item.label}}</text>
          </view>
        </view>
        <text class="trump-caption">{{trumpCaption}}</text>
      </view>
    </view>

    <!-- 牌桌区：三家对手 + 中央出牌区 -->
    <view class="table-area">
      <!-- 上家(对家) / 左家 / 右家：refreshUI 里按 myIndex 算好 -->
      <view class="opp opp-top">
        <view class="opp-avatar">{{oppTop.initial}}</view>
        <text class="opp-count">{{oppTop.count}}张</text>
      </view>
      <view class="opp opp-left">
        <view class="opp-avatar">{{oppLeft.initial}}</view>
        <text class="opp-count">{{oppLeft.count}}张</text>
      </view>
      <view class="opp opp-right">
        <view class="opp-avatar">{{oppRight.initial}}</view>
        <text class="opp-count">{{oppRight.count}}张</text>
      </view>

      <!-- 中央出牌区（按绝对座位 0-3 显示） -->
      <view class="trick-area">
        <view class="trick-slot" wx:for="{{trickCards}}" wx:key="index" wx:if="{{item}}">
          <text class="trick-card {{item.red?'red':''}}">{{item.display}}</text>
        </view>
        <text class="waiting-hint" wx:if="{{!hasPlayedCards && !dealing}}">{{waitingText}}</text>
      </view>

      <!-- 发牌中遮罩：覆盖牌桌区中央，挡住对手头像 -->
      <view class="dealing-overlay" wx:if="{{dealing}}">
        <view class="dealing-spinner"></view>
        <text class="dealing-text">{{dealingText}}</text>
        <text class="dealing-count">已发 {{dealingDone}}/25</text>
      </view>

      <!-- 反牌倒计时遮罩：发牌完成后接管，给非庄家 15s 考虑反主。
           改成只覆盖中央 60% 区域，让顶部亮主区横条始终可见可点击 -->
      <view class="reverse-overlay" wx:if="{{reverseCountdownActive}}">
        <view class="reverse-card">
          <view class="reverse-title">反牌倒计时</view>
          <view class="reverse-clock">
            <view class="reverse-ring">
              <view class="reverse-ring-num">{{reverseCountdown}}</view>
            </view>
          </view>
          <view class="reverse-hint">其他玩家有 {{reverseCountdown}} 秒时间考虑是否反主</view>
          <view class="reverse-tips">提示：点上方 4 个花色/大小王直接亮主叫分</view>
          <button class="reverse-skip-btn" bindtap="onSkipReverseCountdown">开始叫分 →</button>
        </view>
      </view>
    </view>

    <!-- 操作区 -->
    <view class="action-bar">
      <!-- 叫分 -->
      <block wx:if="{{showBidActions}}">
        <button class="op-btn" bindtap="onBidPass">不叫</button>
        <button class="op-btn" bindtap="onBidZero">亮主</button>
        <button class="op-btn" bindtap="onBidOne">1分</button>
        <button class="op-btn" bindtap="onBidTwo">2分</button>
        <button class="op-btn" bindtap="onBidThree">3分</button>
      </block>
      <!-- 反主 -->
      <block wx:if="{{showReverseActions}}">
        <button class="op-btn primary" bindtap="onSkipReverse">不反主</button>
      </block>
      <!-- 出牌 -->
      <block wx:if="{{showPlayActions}}">
        <button class="op-btn primary" bindtap="onPlayConfirm">出牌</button>
        <button class="op-btn" bindtap="onClearSelection">重选</button>
      </block>
      <text class="turn-hint" wx:if="{{!showBidActions && !showReverseActions && !showPlayActions}}">{{waitingText}}</text>
    </view>

    <!-- 手牌区（用普通 view 替代 scroll-view，避免被 flex 父容器压成 0 高度） -->
    <view class="hand-area">
      <view class="hand-cards">
        <view class="hand-card {{item.selected?'selected':''}} {{item.red?'red':''}} {{item.dealing?'dealing-in':''}}"
              wx:for="{{myHand}}" wx:key="index"
              data-index="{{index}}" bindtap="onCardTap">
          <text>{{item.display}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
