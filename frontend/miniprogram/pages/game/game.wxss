/* ================= 页面与背景 ================= */
page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  margin: 0;
  padding: 0;
  background: #0f5c2b;
}

.game-page {
  width: 100%;
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  background: radial-gradient(ellipse at center, #2d8e4e 0%, #1a6e3a 40%, #0f5c2b 100%);
  overflow: hidden;
}

/* 桌布纹理 */
.game-page::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background:
    repeating-linear-gradient(0deg, transparent, transparent 50rpx, rgba(255,255,255,0.015) 50rpx, rgba(255,255,255,0.015) 51rpx),
    repeating-linear-gradient(90deg, transparent, transparent 50rpx, rgba(255,255,255,0.015) 50rpx, rgba(255,255,255,0.015) 51rpx);
  pointer-events: none;
  z-index: 0;
}

/* ================= 状态栏（紧凑：仅返回+帮助） ================= */
.status-bar {
  position: relative;
  z-index: 10;
  flex: 0 0 56rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  gap: 16rpx;
  background: rgba(0,0,0,0.55);
}

.back-btn, .help-btn, .piggy-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 28rpx;
  border-radius: 10rpx;
  background: rgba(255,255,255,0.1);
}

.piggy-icon { margin-left: auto; font-size: 24rpx; }

/* ================= 大厅（游戏未开始时） ================= */
.lobby-stage {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.table-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffd700;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.5);
  letter-spacing: 6rpx;
  margin-bottom: 30rpx;
}

.table-center {
  position: relative;
  width: 90vw;
  height: 56vh;
  max-height: 500rpx;
}

.player-seat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.seat-top { position: absolute; top: 0; left: 50%; transform: translateX(-50%); }
.seat-left { position: absolute; left: 0; top: 50%; transform: translateY(-50%); }
.seat-right { position: absolute; right: 0; top: 50%; transform: translateY(-50%); }
.seat-bottom { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); }

.seat-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.4);
  border: 3rpx solid rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.seat-avatar.ready {
  border-color: #22c55e;
  box-shadow: 0 0 16rpx rgba(34,197,94,0.5);
  background: rgba(34,197,94,0.2);
}

.avatar-letter {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

.seat-name {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.self-name { color: #ffd700; font-weight: bold; }

.seat-status {
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 18rpx;
  background: rgba(0,0,0,0.3);
  color: rgba(255,255,255,0.6);
}

.seat-status.ready {
  background: rgba(34,197,94,0.3);
  color: #22c55e;
}

.seat-cards {
  font-size: 18rpx;
  color: rgba(255,255,255,0.5);
}

.center-buttons {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  align-items: center;
  margin-top: 30rpx;
}

.action-btn {
  width: 220rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  border-radius: 38rpx;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  transition: all 0.3s;
}

.ready-btn {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(34,197,94,0.4);
}

.ready-btn.active {
  background: linear-gradient(135deg, #16a34a, #15803d);
  box-shadow: 0 4rpx 16rpx rgba(34,197,94,0.6);
}

.start-btn {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(245,158,11,0.4);
}

/* ================= 游戏进行阶段（核心布局：5行 flex column） ================= */
.game-stage {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;          /* 关键：允许子项收缩 */
  overflow: hidden;
}

/* 第1行：左上记分面板 + 中央亮主区（都绝对定位在 game-stage 内） */

/* 左上角记分面板 */
.score-panel {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  z-index: 20;
  background: rgba(0, 0, 0, 0.55);
  border: 2rpx solid rgba(255, 215, 0, 0.4);
  border-radius: 12rpx;
  padding: 6rpx 12rpx;
  min-width: 220rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
  pointer-events: none;
}

.score-panel .score-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.9);
}

.score-panel .score-team.mine {
  color: #4ade80;
  font-weight: bold;
}

.score-panel .score-team.opp {
  color: #f87171;
  font-weight: bold;
}

.score-panel .score-points {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.75);
}

.score-panel .score-points.mine { color: #86efac; }
.score-panel .score-points.opp { color: #fca5a5; }

.score-panel .trump-info {
  margin-top: 4rpx;
  padding-top: 4rpx;
  border-top: 1rpx solid rgba(255, 215, 0, 0.2);
  justify-content: center;
}

.score-panel .trump-info-text {
  font-size: 20rpx;
  color: #fbbf24;
  font-weight: bold;
  letter-spacing: 1rpx;
}

/* 中央亮主区 */
.trump-display {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  pointer-events: none;
}

.trump-display .trump-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.trump-display .trump-level-card {
  width: 72rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #fff5d6, #ffe79a);
  border: 3rpx solid #f59e0b;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.5);
}

.trump-display .trump-level-text {
  font-size: 44rpx;
  font-weight: bold;
  color: #b45309;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.5);
}

.trump-display .trump-caption {
  font-size: 24rpx;
  color: #fbbf24;
  font-weight: bold;
  background: rgba(0, 0, 0, 0.6);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(251, 191, 36, 0.4);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.6);
  white-space: nowrap;
}

.trump-display .trump-chips {
  display: flex;
  gap: 8rpx;
  background: rgba(0, 0, 0, 0.55);
  padding: 10rpx 14rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 215, 0, 0.3);
}

.trump-display .trump-chip {
  width: 76rpx;
  height: 86rpx;
  background: linear-gradient(180deg, #2a2a2a, #1a1a1a);
  border: 2rpx solid #555;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  position: relative;
  transition: all 0.3s ease;
}

.trump-display .trump-chip.dim {
  opacity: 0.45;
  border-color: #333;
  background: linear-gradient(180deg, #222, #111);
}

.trump-display .trump-chip.lit {
  border-color: #fbbf24;
  border-width: 3rpx;
  background: linear-gradient(180deg, #fde68a, #fbbf24);
  box-shadow: 0 0 16rpx rgba(251, 191, 36, 0.8), inset 0 0 8rpx rgba(255, 255, 255, 0.3);
  transform: scale(1.05);
}

.trump-display .trump-chip .chip-label {
  font-size: 28rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.6);
}

.trump-display .trump-chip.lit .chip-label {
  color: #7c2d12;
  text-shadow: 0 1rpx 1rpx rgba(255, 255, 255, 0.3);
}

.trump-display .trump-chip.suit-spade .chip-label { color: #d1d5db; }
.trump-display .trump-chip.suit-spade.lit .chip-label { color: #1f2937; }

.trump-display .trump-chip.suit-heart .chip-label { color: #fca5a5; }
.trump-display .trump-chip.suit-heart.lit .chip-label { color: #b91c1c; }

.trump-display .trump-chip.suit-club .chip-label { color: #86efac; }
.trump-display .trump-chip.suit-club.lit .chip-label { color: #14532d; }

.trump-display .trump-chip.suit-diamond .chip-label { color: #93c5fd; }
.trump-display .trump-chip.suit-diamond.lit .chip-label { color: #1e3a8a; }

.trump-display .trump-chip.suit-joker .chip-label { color: #fde68a; }
.trump-display .trump-chip.suit-joker.lit .chip-label { color: #92400e; }

.trump-display .trump-chip .chip-sub {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: bold;
}

.trump-display .trump-chip.lit .chip-sub {
  color: rgba(124, 45, 18, 0.7);
}

/* 第2行：牌桌区 - flex: 1 自适应 */
.table-area {
  position: relative;
  flex: 1 1 0;
  min-height: 180rpx;     /* 至少 180rpx 保证对手头像不被压扁 */
  overflow: hidden;
}

/* 对手头像 - 四个角定位在 table-area 内部 */
.opp {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  z-index: 2;
}

.opp-top {
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
}

.opp-left {
  top: 50%;
  left: 20rpx;
  transform: translateY(-50%);
}

.opp-right {
  top: 50%;
  right: 20rpx;
  transform: translateY(-50%);
}

.opp-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255,255,255,0.3);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.opp-count {
  font-size: 18rpx;
  color: rgba(255,255,255,0.75);
  background: rgba(0,0,0,0.4);
  padding: 0 8rpx;
  border-radius: 10rpx;
}

/* 中央出牌区 - 绝对定位在 table-area 中央 */
.trick-area {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  gap: 14rpx;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  max-width: 60%;
  z-index: 3;
  pointer-events: none;
}

.trick-card {
  background: #fff;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #111;
  box-shadow: 0 3rpx 8rpx rgba(0,0,0,0.4);
}

.trick-card.red { color: #dc2626; }

/* 等待提示 - 放 table-area 底部中央，不挡操作栏 */
.waiting-hint {
  position: absolute;
  bottom: 6rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 20rpx;
  color: rgba(255,255,255,0.75);
  background: rgba(0,0,0,0.4);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin: 0 auto;
  width: fit-content;
  z-index: 2;
}

/* 第3行：操作栏 - 固定 80rpx */
.action-bar {
  flex: 0 0 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 0 16rpx;
  background: rgba(0,0,0,0.4);
  flex-wrap: nowrap;
  overflow: hidden;
}

.op-btn {
  margin: 0;
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.15);
  color: #fff;
  border: none;
  white-space: nowrap;
  flex-shrink: 0;
}

.op-btn.primary {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(245,158,11,0.4);
}

.turn-hint {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  text-align: center;
}

/* 第4行：手牌 - 固定 140rpx，25张缩小到能单屏放下 */
.hand-area {
  flex: 0 0 140rpx;
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  background: rgba(0,0,0,0.4);
  overflow-x: auto;
  overflow-y: hidden;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
}

.hand-cards {
  display: inline-flex;
  align-items: center;
  flex-wrap: nowrap;
  min-width: 100%;
}

.hand-card {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 110rpx;
  margin-right: -34rpx;
  background: #fff;
  border: 2rpx solid #cbd5e1;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #111;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.3);
}

.hand-card.red { color: #dc2626; }

.hand-card.selected {
  transform: translateY(-22rpx);
  border-color: #f59e0b;
  box-shadow: 0 4rpx 10rpx rgba(245,158,11,0.5);
  z-index: 10;
}

.hand-card:last-child {
  margin-right: 0;
}

/* 锁定提示（用于未登录/异常状态） */
.lock-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 28rpx;
  z-index: 100;
}

.lock-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255,255,255,0.2);
  border-top-color: #fbbf24;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
