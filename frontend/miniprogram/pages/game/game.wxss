/* ================= 页面与背景 ================= */
page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  margin: 0;
  padding: 0;
  background: #0f5c2b;
}

.game-page {
  width: 100%;
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  background: radial-gradient(ellipse at center, #2d8e4e 0%, #1a6e3a 40%, #0f5c2b 100%);
  overflow: hidden;
}

/* 桌布纹理 */
.game-page::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background:
    repeating-linear-gradient(0deg, transparent, transparent 50rpx, rgba(255,255,255,0.015) 50rpx, rgba(255,255,255,0.015) 51rpx),
    repeating-linear-gradient(90deg, transparent, transparent 50rpx, rgba(255,255,255,0.015) 50rpx, rgba(255,255,255,0.015) 51rpx);
  pointer-events: none;
  z-index: 0;
}

/* ================= 状态栏（紧凑：仅返回+帮助） ================= */
.status-bar {
  position: relative;
  z-index: 10;
  flex: 0 0 40rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  gap: 16rpx;
  background: rgba(0,0,0,0.55);
}

.back-btn, .help-btn, .piggy-icon {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
  border-radius: 8rpx;
  background: rgba(255,255,255,0.1);
}

.piggy-icon { margin-left: auto; font-size: 24rpx; }

/* ================= 大厅（游戏未开始时） ================= */
.lobby-stage {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.table-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffd700;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.5);
  letter-spacing: 6rpx;
  margin-bottom: 30rpx;
}

.table-center {
  position: relative;
  width: 90vw;
  height: 56vh;
  max-height: 500rpx;
}

.player-seat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.seat-top { position: absolute; top: 0; left: 50%; transform: translateX(-50%); }
.seat-left { position: absolute; left: 0; top: 50%; transform: translateY(-50%); }
.seat-right { position: absolute; right: 0; top: 50%; transform: translateY(-50%); }
.seat-bottom { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); }

.seat-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.4);
  border: 3rpx solid rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.seat-avatar.ready {
  border-color: #22c55e;
  box-shadow: 0 0 16rpx rgba(34,197,94,0.5);
  background: rgba(34,197,94,0.2);
}

.avatar-letter {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

.seat-name {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.self-name { color: #ffd700; font-weight: bold; }

.seat-status {
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 18rpx;
  background: rgba(0,0,0,0.3);
  color: rgba(255,255,255,0.6);
}

.seat-status.ready {
  background: rgba(34,197,94,0.3);
  color: #22c55e;
}

.seat-cards {
  font-size: 18rpx;
  color: rgba(255,255,255,0.5);
}

.center-buttons {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  align-items: center;
  margin-top: 30rpx;
}

.action-btn {
  width: 220rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  border-radius: 38rpx;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  transition: all 0.3s;
}

.ready-btn {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(34,197,94,0.4);
}

.ready-btn.active {
  background: linear-gradient(135deg, #16a34a, #15803d);
  box-shadow: 0 4rpx 16rpx rgba(34,197,94,0.6);
}

.start-btn {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(245,158,11,0.4);
}

/* ================= 游戏进行阶段（绝对定位：手牌永远固定在底部） ================= */
.game-stage {
  position: relative;
  z-index: 1;
  flex: 1;
  overflow: hidden;
}

/* 第1行：顶部条 - 紧凑 56rpx，左记分面板 + 右亮主区横条 */
.top-bar {
  position: absolute;
  top: 40rpx; left: 0; right: 0;
  height: 56rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 2rpx 6rpx;
  background: rgba(0,0,0,0.5);
  overflow: hidden;
  z-index: 5;
}

/* 左上角记分面板 - 紧凑三列内嵌在一行 */
.score-panel {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  background: rgba(0, 0, 0, 0.55);
  border: 1.5rpx solid rgba(255, 215, 0, 0.4);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  min-width: 240rpx;
  max-width: 360rpx;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.5);
  flex-shrink: 0;
  pointer-events: none;
  height: 48rpx;
  align-items: center;
}

.score-panel .score-col {
  display: flex;
  flex-direction: column;
  gap: 0rpx;
  flex-shrink: 0;
  min-width: 70rpx;
}

.score-panel .score-col-label {
  font-size: 16rpx;
  color: rgba(255, 215, 0, 0.7);
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.score-panel .score-col-value {
  font-size: 22rpx;
  font-weight: bold;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.9);
}

.score-panel .score-col-value.mine { color: #4ade80; }
.score-panel .score-col-value.opp { color: #f87171; }
.score-panel .score-col-value.trump { color: #fbbf24; font-size: 20rpx; }

.score-panel .score-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.9);
}

.score-panel .score-team.mine {
  color: #4ade80;
  font-weight: bold;
}

.score-panel .score-team.opp {
  color: #f87171;
  font-weight: bold;
}

.score-panel .score-points {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.75);
}

.score-panel .score-points.mine { color: #86efac; }
.score-panel .score-points.opp { color: #fca5a5; }

.score-panel .trump-info {
  margin-top: 4rpx;
  padding-top: 4rpx;
  border-top: 1rpx solid rgba(255, 215, 0, 0.2);
  justify-content: center;
}

.score-panel .trump-info-text {
  font-size: 20rpx;
  color: #fbbf24;
  font-weight: bold;
  letter-spacing: 1rpx;
}

/* 中央亮主区 - 顶部横条右侧，不再 absolute 居中 */
.trump-display {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  max-width: 60%;
}

.trump-display .trump-chips {
  display: flex;
  gap: 4rpx;
  background: rgba(0, 0, 0, 0.55);
  padding: 4rpx 8rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 215, 0, 0.3);
}

.trump-display .trump-chip {
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(180deg, #2a2a2a, #1a1a1a);
  border: 2rpx solid #555;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.3s ease;
}

.trump-display .trump-chip.clickable {
  cursor: pointer;
  border-color: #fbbf24;
  box-shadow: 0 0 6rpx rgba(251, 191, 36, 0.5);
  animation: chipBreath 1.6s ease-in-out infinite;
}

.trump-display .trump-chip.clickable:active {
  transform: scale(0.92);
  background: linear-gradient(180deg, #fde68a, #fbbf24);
}

/* 可亮/可反主花色：持牌即“亮起”（金色呼吸光晕），与 dim 形成对比，提示玩家可点 */
.trump-display .trump-chip.available {
  border-color: #fbbf24;
  background: linear-gradient(180deg, #3a2f10, #2a2110);
  box-shadow: 0 0 8rpx rgba(251, 191, 36, 0.75), inset 0 0 4rpx rgba(251, 191, 36, 0.4);
  animation: chipBreath 1.6s ease-in-out infinite;
}

.trump-display .trump-chip.available .chip-label {
  color: #fde68a;
}

@keyframes chipBreath {
  0%, 100% { box-shadow: 0 0 6rpx rgba(251, 191, 36, 0.4); }
  50% { box-shadow: 0 0 14rpx rgba(251, 191, 36, 0.9); }
}

.trump-display .trump-chip.dim {
  opacity: 0.4;
  border-color: #333;
  background: linear-gradient(180deg, #222, #111);
}

.trump-display .trump-chip.lit {
  border-color: #fbbf24;
  border-width: 2rpx;
  background: linear-gradient(180deg, #fde68a, #fbbf24);
  box-shadow: 0 0 8rpx rgba(251, 191, 36, 0.7), inset 0 0 4rpx rgba(255, 255, 255, 0.3);
  transform: scale(1.08);
}

.trump-display .trump-chip .chip-label {
  font-size: 18rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1;
}

.trump-display .trump-chip.lit .chip-label {
  color: #7c2d12;
  text-shadow: 0 1rpx 1rpx rgba(255, 255, 255, 0.3);
}

.trump-display .trump-chip.suit-spade .chip-label { color: #d1d5db; }
.trump-display .trump-chip.suit-spade.lit .chip-label { color: #1f2937; }
.trump-display .trump-chip.suit-heart .chip-label { color: #fca5a5; }
.trump-display .trump-chip.suit-heart.lit .chip-label { color: #b91c1c; }
.trump-display .trump-chip.suit-club .chip-label { color: #86efac; }
.trump-display .trump-chip.suit-club.lit .chip-label { color: #14532d; }
.trump-display .trump-chip.suit-diamond .chip-label { color: #93c5fd; }
.trump-display .trump-chip.suit-diamond.lit .chip-label { color: #1e3a8a; }
.trump-display .trump-chip.suit-joker .chip-label { color: #fde68a; }
.trump-display .trump-chip.suit-joker.lit .chip-label { color: #92400e; }

.trump-display .trump-caption {
  font-size: 18rpx;
  color: #fbbf24;
  font-weight: bold;
  background: rgba(0, 0, 0, 0.6);
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(251, 191, 36, 0.4);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.6);
  white-space: nowrap;
}

/* 第2行：牌桌区 - 顶部条下方到底部 124rpx 之间（给操作栏 60 + 手牌 64 留位置） */
.table-area {
  position: absolute;
  top: 96rpx;
  left: 0;
  right: 0;
  bottom: 124rpx;          /* action-bar 60 + hand-area 64 */
  overflow: hidden;
}

/* 对手头像 - 四个角定位在 table-area 内部 */
.opp {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  z-index: 2;
}

.opp-top {
  top: 50rpx;
  left: 50%;
  transform: translateX(-50%);
}

.opp-left {
  top: 50%;
  left: 20rpx;
  transform: translateY(-50%);
}

.opp-right {
  top: 50%;
  right: 20rpx;
  transform: translateY(-50%);
}

.opp-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255,255,255,0.3);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.opp-count {
  font-size: 18rpx;
  color: rgba(255,255,255,0.75);
  background: rgba(0,0,0,0.4);
  padding: 0 8rpx;
  border-radius: 10rpx;
}

/* 对手手牌：一排"背面牌"扇，直观显示该玩家手里有一叠牌（不透露牌面，符合对局规则） */
.opp-hand {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 22rpx;
  margin-top: 3rpx;
}

.opp-back {
  width: 14rpx;
  height: 20rpx;
  margin-right: -8rpx;
  border-radius: 2rpx;
  background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
  border: 1rpx solid rgba(255,255,255,0.55);
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.35);
  flex-shrink: 0;
}

.opp-back:first-child {
  margin-left: 0;
}

/* 对手亮牌区 - 头像下方一组小 chip，显示该玩家最后叫的主花色 */
.opp-bid-chips {
  display: flex;
  align-items: center;
  gap: 3rpx;
  background: rgba(0, 0, 0, 0.55);
  border: 1rpx solid rgba(255, 215, 0, 0.35);
  border-radius: 10rpx;
  padding: 2rpx 6rpx;
  margin-top: 2rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.opp-bid-label {
  font-size: 14rpx;
  color: rgba(255, 215, 0, 0.75);
  font-weight: bold;
  letter-spacing: 1rpx;
}

.opp-bid-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #2a2a2a, #1a1a1a);
  border: 1.5rpx solid #555;
  border-radius: 5rpx;
  flex-shrink: 0;
}

.opp-bid-chip.lit {
  background: linear-gradient(180deg, #fde68a, #fbbf24);
  border-color: #fbbf24;
  box-shadow: 0 0 6rpx rgba(251, 191, 36, 0.6);
}

.opp-bid-chip .opp-bid-chip-label {
  font-size: 16rpx;
  font-weight: bold;
  line-height: 1;
}

.opp-bid-chip.suit-spade .opp-bid-chip-label { color: #d1d5db; }
.opp-bid-chip.suit-spade.lit .opp-bid-chip-label { color: #1f2937; }
.opp-bid-chip.suit-heart .opp-bid-chip-label { color: #fca5a5; }
.opp-bid-chip.suit-heart.lit .opp-bid-chip-label { color: #b91c1c; }
.opp-bid-chip.suit-club .opp-bid-chip-label { color: #86efac; }
.opp-bid-chip.suit-club.lit .opp-bid-chip-label { color: #14532d; }
.opp-bid-chip.suit-diamond .opp-bid-chip-label { color: #93c5fd; }
.opp-bid-chip.suit-diamond.lit .opp-bid-chip-label { color: #1e3a8a; }
.opp-bid-chip.suit-joker .opp-bid-chip-label { color: #fde68a; }
.opp-bid-chip.suit-joker.lit .opp-bid-chip-label { color: #92400e; }

/* 中央出牌区 - 绝对定位在 table-area 中央 */
.trick-area {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  gap: 14rpx;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  max-width: 60%;
  z-index: 3;
  pointer-events: none;
}

.trick-card {
  background: #fff;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #111;
  box-shadow: 0 3rpx 8rpx rgba(0,0,0,0.4);
}

.trick-card.red { color: #dc2626; }

/* 等待提示 - 放 table-area 底部中央，不挡操作栏 */
.waiting-hint {
  position: absolute;
  bottom: 6rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 20rpx;
  color: rgba(255,255,255,0.75);
  background: rgba(0,0,0,0.4);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin: 0 auto;
  width: fit-content;
  z-index: 2;
}

/* 发牌遮罩 - 顶部细横幅，只占顶部一小条，不遮挡对手与手牌 */
.dealing-overlay {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 44rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: rgba(0, 0, 0, 0.62);
  z-index: 15;
  border-bottom: 1rpx solid rgba(251, 191, 36, 0, 0.4);
}

.dealing-overlay .dealing-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid rgba(255,255,255,0.2);
  border-top-color: #fbbf24;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

.dealing-overlay .dealing-text {
  font-size: 26rpx;
  color: #fbbf24;
  font-weight: bold;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.6);
}

.dealing-overlay .dealing-count {
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
  background: rgba(0,0,0,0.4);
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
}

/* ===== 反牌倒计时遮罩：改成顶部条状，贴 top-bar 下方，不挡中央牌桌区 ===== */
.reverse-overlay {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: linear-gradient(180deg, rgba(30, 58, 95, 0.95) 0%, rgba(15, 31, 51, 0.95) 100%);
  border-bottom: 2rpx solid #fbbf24;
  z-index: 18;
  padding: 0 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.5);
}

.reverse-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  justify-content: space-between;
}

.reverse-card .reverse-title {
  font-size: 24rpx;
  color: #fbbf24;
  font-weight: bold;
  letter-spacing: 2rpx;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.5);
}

.reverse-card .reverse-clock {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reverse-card .reverse-ring {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fbbf24, #d97706);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 12rpx rgba(251, 191, 36, 0.6);
  animation: ringPulse 1.6s ease-in-out infinite;
}

.reverse-card .reverse-ring-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #1e3a5f, #0a1424);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: bold;
  color: #fbbf24;
  text-shadow: 0 0 6rpx rgba(251, 191, 36, 0.6);
  font-family: 'Courier New', monospace;
}

@keyframes ringPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.reverse-card .reverse-hint {
  font-size: 18rpx;
  color: rgba(255,255,255,0.9);
  line-height: 1.3;
  flex: 1;
  text-align: center;
}

.reverse-card .reverse-tips {
  font-size: 16rpx;
  color: rgba(251, 191, 36, 0.7);
  background: rgba(0,0,0,0.3);
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.reverse-card .reverse-skip-btn {
  margin: 0;
  padding: 0 20rpx;
  height: 40rpx;
  line-height: 40rpx;
  font-size: 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: white;
  font-weight: bold;
  border: none;
  box-shadow: 0 2rpx 6rpx rgba(245,158,11,0.4);
  flex-shrink: 0;
}

/* 翻牌动画：每张新牌从顶部"牌堆"飞入手中，清晰呈现逐张发牌 */
.hand-card.dealing-in {
  animation: dealFlyIn 0.45s ease-out backwards;
}

@keyframes dealFlyIn {
  0% {
    transform: translateY(-320rpx) translateX(-40rpx) scale(0.5) rotate(-12deg);
    opacity: 0;
  }
  60% {
    opacity: 1;
  }
  100% {
    transform: translateY(0) translateX(0) scale(1) rotate(0);
    opacity: 1;
  }
}

/* 第3行：操作栏 - 固定 60rpx，绝对定位在手牌上方 */
.action-bar {
  position: absolute;
  bottom: 64rpx;          /* 紧贴 hand-area 上方（hand-area 高 64rpx） */
  left: 0;
  right: 0;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 0 16rpx;
  background: rgba(0,0,0,0.4);
  flex-wrap: nowrap;
  overflow: hidden;
  z-index: 7;
}

.op-btn {
  margin: 0;
  padding: 0 20rpx;
  height: 44rpx;
  line-height: 44rpx;
  font-size: 22rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.15);
  color: #fff;
  border: none;
  white-space: nowrap;
  flex-shrink: 0;
}

.op-btn.primary {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(245,158,11,0.4);
}

.turn-hint {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  text-align: center;
}

/* 第4行：手牌 - 绝对定位贴底 80rpx（更紧凑，25张不滚） */
.hand-area {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 64rpx;
  width: 100%;
  box-sizing: border-box;
  display: block;
  padding: 3rpx 4rpx;
  background: linear-gradient(180deg, rgba(20, 40, 20, 0.92), rgba(0, 0, 0, 0.85));
  border-top: 1.5rpx solid rgba(255, 215, 0, 0.35);
  overflow-x: hidden;
  overflow-y: hidden;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
  z-index: 6;
}

.hand-cards {
  display: inline-flex;
  align-items: center;
  flex-wrap: nowrap;
  min-width: 100%;
  height: 100%;
}

/* ================= 单张牌（三段式：顶小字/中数字+小花/底大花） ================= */
.hand-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  width: 34rpx;                /* 缩小：25 张×(34-8)=650rpx，单排即可放下，不再横向滚动 */
  height: 48rpx;
  margin-right: -8rpx;          /* 重叠，让每张牌至少露 26rpx 牌面 */
  padding: 1rpx 0;
  background: #fff;
  border: 1rpx solid #cbd5e1;
  border-radius: 3rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 1rpx 1rpx rgba(0,0,0,0.35);
  overflow: hidden;
}

/* 顶小字（普通牌显示小写花色，JOKER 显示"JOKER"红斜体） */
.hand-card-top {
  width: 100%;
  font-size: 10rpx;
  line-height: 12rpx;
  text-align: center;
  font-weight: bold;
  font-style: italic;
  color: inherit;
  margin-top: 1rpx;
}

.hand-card.joker .hand-card-top {
  color: #dc2626;
  font-size: 9rpx;
  line-height: 11rpx;
  letter-spacing: 0.3rpx;
}

/* 中间：数字 + 小花色 */
.hand-card-center {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 1rpx;
  font-weight: bold;
  line-height: 1;
  margin-top: -1rpx;
}

.hand-card-rank {
  font-size: 16rpx;
  line-height: 18rpx;
}

.hand-card-suit-small {
  font-size: 11rpx;
  line-height: 11rpx;
  margin-left: 1rpx;
}

.hand-card.joker .hand-card-rank {
  font-size: 14rpx;
  line-height: 14rpx;
}

.hand-card.joker .hand-card-suit-small {
  font-size: 10rpx;
  line-height: 10rpx;
}

/* 底大花色（占牌底 1/3 高度，参考图） */
.hand-card-bottom {
  width: 100%;
  font-size: 18rpx;
  line-height: 20rpx;
  text-align: center;
  font-weight: bold;
  margin-bottom: -1rpx;
}

.hand-card.joker .hand-card-bottom {
  font-size: 15rpx;
  line-height: 16rpx;
}

/* 红色花色（红桃、方块、大小王主显示） */
.hand-card.suit-heart,
.hand-card.suit-diamond,
.hand-card.joker {
  color: #dc2626;
}

/* 黑色花色（黑桃、梅花） */
.hand-card.suit-spade,
.hand-card.suit-club {
  color: #111;
}

.hand-card.selected {
  transform: translateY(-10rpx);
  border-color: #f59e0b;
  border-width: 2rpx;
  box-shadow: 0 4rpx 10rpx rgba(245,158,11,0.6);
  z-index: 10;
}

/* 锁定提示（用于未登录/异常状态） */
.lock-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 28rpx;
  z-index: 100;
}

.lock-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255,255,255,0.2);
  border-top-color: #fbbf24;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
