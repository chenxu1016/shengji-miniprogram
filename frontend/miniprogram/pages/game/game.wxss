/* ================= 页面与桌布 ================= */
page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  margin: 0;
  padding: 0;
  background: #0d3b24;
}

.game-page {
  width: 100%;
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  /* 多乐升级风格：中心亮绿草地桌面 + 四周深绿暗角 */
  background:
    radial-gradient(ellipse at 50% 34%, #58a85f 0%, #3d8c4e 38%, #216b3c 68%, #0d3b24 100%);
}

.game-page::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background:
    repeating-linear-gradient(0deg, transparent, transparent 46rpx, rgba(255,255,255,0.022) 46rpx, rgba(255,255,255,0.022) 47rpx),
    repeating-linear-gradient(90deg, transparent, transparent 46rpx, rgba(0,0,0,0.018) 46rpx, rgba(0,0,0,0.018) 47rpx);
  pointer-events: none;
  z-index: 0;
}

/* ================= 顶部系统条 ================= */
.status-bar {
  position: relative;
  z-index: 10;
  flex: 0 0 64rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  gap: 12rpx;
  background: rgba(0, 0, 0, 0.42);
  border-bottom: 1rpx solid rgba(255, 215, 0, 0.18);
}

.back-btn, .help-btn, .piggy-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.12);
  flex-shrink: 0;
}
.back-btn { font-size: 40rpx; line-height: 34rpx; }
.room-chip {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(0, 0, 0, 0.3);
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
}
.status-spacer { flex: 1; }

/* ================= 大厅 ================= */
.lobby-stage {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.table-title {
  font-size: 46rpx;
  font-weight: bold;
  color: #ffe9a8;
  text-shadow: 0 4rpx 14rpx rgba(0,0,0,0.6);
  letter-spacing: 8rpx;
  margin-bottom: 26rpx;
}
.table-center {
  position: relative;
  width: 90vw;
  height: 54vh;
  max-height: 500rpx;
  border: 2rpx solid rgba(255, 215, 0, 0.25);
  border-radius: 40rpx;
  background: rgba(0, 0, 0, 0.12);
  box-shadow: inset 0 0 50rpx rgba(0,0,0,0.2);
}
.player-seat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.seat-top { position: absolute; top: 8rpx; left: 50%; transform: translateX(-50%); }
.seat-left { position: absolute; left: 10rpx; top: 50%; transform: translateY(-50%); }
.seat-right { position: absolute; right: 10rpx; top: 50%; transform: translateY(-50%); }
.seat-bottom { position: absolute; bottom: 8rpx; left: 50%; transform: translateX(-50%); }
.seat-avatar {
  width: 76rpx; height: 76rpx; border-radius: 20rpx;
  background: linear-gradient(135deg, #4b6cb7, #182848);
  border: 2rpx solid rgba(255,255,255,0.45);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.35);
}
.seat-avatar.ready { border-color: #4ade80; box-shadow: 0 0 18rpx rgba(74,222,128,0.6); }
.avatar-letter { font-size: 34rpx; font-weight: bold; color: #fff; }
.seat-name { font-size: 22rpx; color: #fff; max-width: 150rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: center; }
.self-name { color: #ffe9a8; font-weight: bold; }
.seat-status { font-size: 18rpx; padding: 2rpx 14rpx; border-radius: 18rpx; background: rgba(0,0,0,0.42); color: rgba(255,255,255,0.65); }
.seat-status.ready { background: rgba(34,197,94,0.32); color: #86efac; }
.seat-cards { font-size: 18rpx; color: rgba(255,255,255,0.6); }
.empty-seat { opacity: 0.55; }
.empty-seat .seat-avatar { border-style: dashed; background: rgba(0,0,0,0.2); }
.self-avatar { border-color: #ffd700; box-shadow: 0 0 18rpx rgba(255,215,0,0.5); background: linear-gradient(135deg, #f59e0b, #b45309); }
.center-buttons { display: flex; flex-direction: row; gap: 20rpx; align-items: center; margin-top: 30rpx; }
.action-btn {
  width: 220rpx; height: 78rpx; line-height: 78rpx; font-size: 28rpx;
  border-radius: 40rpx; border: none; padding: 0;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-weight: bold;
}
.ready-btn { background: linear-gradient(135deg, #34d399, #059669); box-shadow: 0 6rpx 16rpx rgba(5,150,105,0.45); }
.ready-btn.active { background: linear-gradient(135deg, #16a34a, #15803d); }
.start-btn { background: linear-gradient(135deg, #fcd34d, #d97706); color: #4a2c00; box-shadow: 0 6rpx 16rpx rgba(217,119,6,0.45); }
.lobby-hint { margin-top: 22rpx; font-size: 22rpx; color: rgba(255,255,255,0.85); background: rgba(0,0,0,0.4); padding: 8rpx 28rpx; border-radius: 24rpx; }

/* ================= 常驻座位按钮栏：坐下 / 站起 / 准备 ================= */
.seat-toolbar {
  position: relative;
  z-index: 30;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-wrap: nowrap;
  gap: 12rpx;
  margin-top: 26rpx;
  padding: 0 16rpx;
  width: 100%;
  box-sizing: border-box;
}
.seat-tool-btn {
  flex: 0 0 auto;
  min-width: 104rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 20rpx;
  border-radius: 30rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  white-space: nowrap;
  background: linear-gradient(135deg, rgba(255,255,255,0.24), rgba(255,255,255,0.10));
  border: 1rpx solid rgba(255,255,255,0.34);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.30);
}
.seat-tool-btn.is-primary { background: linear-gradient(135deg, #ffd86b, #e9a11b); color: #4a2c00; border-color: #ffe9a8; }
.seat-tool-btn.is-go { background: linear-gradient(135deg, #34d399, #059669); border-color: rgba(134,239,172,0.85); }
.seat-tool-btn.is-active { background: linear-gradient(135deg, #16a34a, #15803d); border-color: #86efac; }
.seat-tool-btn.is-gold { background: linear-gradient(135deg, #fcd34d, #d97706); color: #4a2c00; border-color: #ffe9a8; }
.seat-tool-btn.is-ghost { background: rgba(0,0,0,0.38); color: rgba(255,255,255,0.88); border-color: rgba(255,255,255,0.22); }
.seat-tool-btn.is-off { opacity: 0.40; filter: grayscale(0.35); }
.seat-tool-btn:active { transform: translateY(2rpx); opacity: 0.85; }

/* 牌桌 dock 里的紧凑版：与出牌按钮同行，不再额外占高度 */
.seat-toolbar.compact {
  margin-top: 0;
  padding: 0;
  gap: 6rpx;
  width: auto;
  flex: 0 0 auto;
  min-width: 0;
}
.seat-toolbar.compact .seat-tool-btn {
  min-width: 0;
  height: 46rpx;
  line-height: 46rpx;
  padding: 0 12rpx;
  font-size: 19rpx;
  border-radius: 23rpx;
  box-shadow: none;
}
/* 按钮栏常驻后，dock 里的文字提示让位给按钮 */
.dock-tip { display: none; }

/* ================= 对局主容器（四行分区，互不重叠） ================= */
.game-stage {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 内嵌牌桌：金色细边圆角面板 */
.felt {
  position: absolute;
  top: 116rpx;
  bottom: 312rpx;          /* dock 96 + hand 216 */
  left: 14rpx;
  right: 14rpx;
  border-radius: 44rpx;
  border: 2rpx solid rgba(255, 215, 0, 0.28);
  background: linear-gradient(180deg, rgba(255,255,255,0.075), rgba(0,0,0,0.10));
  box-shadow: inset 0 0 60rpx rgba(0,0,0,0.22), 0 8rpx 26rpx rgba(0,0,0,0.18);
  pointer-events: none;
  z-index: 0;
}

/* ---------- 第一行：HUD ---------- */
.hud-zone {
  position: relative;
  z-index: 3;
  flex: 0 0 132rpx;
}

/* 左上记分板（黑底圆角，仿多乐） */
.score-board {
  position: absolute;
  left: 16rpx; top: 12rpx;
  width: 244rpx;
  background: rgba(0, 0, 0, 0.62);
  border: 1rpx solid rgba(255,255,255,0.14);
  border-radius: 16rpx;
  padding: 10rpx 14rpx;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.3);
}
.score-row { display: flex; align-items: center; gap: 10rpx; height: 42rpx; }
.score-team { font-size: 22rpx; color: #fff; font-weight: bold; width: 52rpx; }
.score-level { font-size: 28rpx; font-weight: bold; width: 36rpx; text-align: center; }
.score-level.mine { color: #86efac; }
.score-level.opp { color: #fca5a5; }
.score-sep { width: 1rpx; height: 24rpx; background: rgba(255,255,255,0.2); }
.score-label { font-size: 20rpx; color: rgba(255,255,255,0.6); }
.score-point { font-size: 24rpx; color: #ffe9a8; font-weight: bold; margin-left: auto; }

/* 顶部中央级牌大卡（金色描边） */
.level-card {
  position: absolute;
  left: 50%; top: 6rpx;
  transform: translateX(-50%);
  width: 128rpx; height: 118rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #fffdf2, #f3e6c4);
  border: 3rpx solid #e0ad4a;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.4), inset 0 0 0 3rpx rgba(255,255,255,0.85);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.level-num { font-size: 62rpx; line-height: 66rpx; font-weight: 900; color: #e08a2e; text-shadow: 0 2rpx 0 rgba(255,255,255,0.8); }
.level-cap { font-size: 17rpx; color: #8a5a20; letter-spacing: 1rpx; }

.trump-badge {
  position: absolute;
  right: 16rpx; top: 26rpx;
  display: flex; flex-direction: column; align-items: center;
  background: rgba(0,0,0,0.55);
  border: 1rpx solid rgba(255,215,0,0.35);
  border-radius: 16rpx;
  padding: 8rpx 18rpx;
}
.trump-badge-label { font-size: 17rpx; color: #ffd700; }
.trump-badge-char { font-size: 40rpx; line-height: 42rpx; font-weight: bold; color: #e8eef5; }
.trump-badge-char.red { color: #ff8f85; }
.trump-badge-char.black { color: #cfd8e3; }
.trump-badge-char.none { font-size: 24rpx; color: #ffd700; }
.trump-badge-value { font-size: 24rpx; color: #fff; font-weight: bold; }

/* ---------- 第二行：牌桌 ---------- */
.table-zone {
  position: relative;
  z-index: 2;
  flex: 1;
}

/* 四角玩家卡片 */
.pseat {
  position: absolute;
  width: 224rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 10rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.55);
  border: 1.5rpx solid rgba(255, 215, 0, 0.32);
  border-radius: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.3);
  transition: border-color 0.25s, box-shadow 0.25s;
  z-index: 6;
}
.pseat.active {
  border-color: #ffd54a;
  box-shadow: 0 0 20rpx rgba(255, 213, 74, 0.75), 0 4rpx 14rpx rgba(0,0,0,0.35);
}
/* 庄家：谁的庄就在谁那一栏亮起 */
.pseat.banker {
  border-color: #ffb300;
  background: linear-gradient(180deg, rgba(92,62,4,0.94), rgba(40,28,2,0.94));
  box-shadow: 0 0 20rpx rgba(255,180,0,0.6), 0 4rpx 14rpx rgba(0,0,0,0.35);
}
.pseat-banker {
  position: absolute; left: -10rpx; top: -12rpx;
  min-width: 30rpx; height: 30rpx; padding: 0 5rpx;
  box-sizing: border-box; border-radius: 15rpx;
  background: linear-gradient(180deg, #ffe9a8, #e8a32b);
  border: 1rpx solid #fff3c4;
  color: #5b3a00; font-size: 18rpx; font-weight: bold;
  display: flex; align-items: center; justify-content: center;
  z-index: 9;
}
.pseat-top { top: 6rpx; left: 50%; transform: translateX(-50%); }
.pseat-left { top: 37%; left: 12rpx; }
.pseat-right { top: 37%; right: 12rpx; }
.pseat-face {
  width: 62rpx; height: 62rpx; flex-shrink: 0;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #5b7bd8, #22306b);
  border: 2rpx solid rgba(255,255,255,0.55);
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: bold; color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.35);
}
.pseat.active .pseat-face { border-color: #ffd54a; box-shadow: 0 0 14rpx rgba(255,213,74,0.7); }
.pseat-face.offline { filter: grayscale(1); opacity: 0.55; }
.pseat-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.pseat-nick { font-size: 20rpx; color: #fff; font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pseat-sub { display: flex; align-items: center; gap: 8rpx; }
.pseat-count { font-size: 18rpx; color: #ffe9a8; flex-shrink: 0; }
.mini-backs { display: flex; align-items: center; height: 22rpx; overflow: hidden; }
.mini-back {
  width: 14rpx; height: 20rpx; margin-right: -7rpx;
  border-radius: 3rpx;
  background: linear-gradient(135deg, #2f6fd0, #173e8c);
  border: 1rpx solid rgba(255,255,255,0.6);
  flex-shrink: 0;
}
.pseat-bid {
  position: absolute; right: 6rpx; top: -14rpx;
  min-width: 30rpx; height: 30rpx; padding: 0 6rpx;
  border-radius: 15rpx;
  background: linear-gradient(180deg, #fde68a, #f5a623);
  color: #4a2c00; font-size: 18rpx; font-weight: bold;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4);
}

/* 亮主条（仿多乐：金色胶囊 6 格） */
.bid-zone {
  position: absolute;
  top: 126rpx; left: 50%;
  transform: translateX(-50%);
  width: 636rpx;
  z-index: 25;   /* 高于发牌/倒计时浮层：发牌过程中亮主条始终可点 */
}
.bid-banner {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  height: 42rpx; margin-bottom: 6rpx;
}
.bid-tag {
  font-size: 20rpx; font-weight: bold; color: #4a2c00;
  background: linear-gradient(180deg, #ffd97a, #eda32b);
  border-radius: 16rpx 16rpx 0 0;
  padding: 4rpx 18rpx;
  box-shadow: 0 -2rpx 10rpx rgba(255,190,60,0.4);
}
.bid-caption {
  font-size: 24rpx; font-weight: bold; color: #fff8dc;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.75), 0 0 10rpx rgba(255,215,0,0.4);
  max-width: 460rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.bid-strip {
  height: 88rpx;
  display: flex; align-items: stretch;
  padding: 5rpx;
  box-sizing: border-box;
  border-radius: 44rpx;
  background: rgba(18, 26, 18, 0.78);
  border: 3rpx solid #e2b04c;
  box-shadow: 0 8rpx 22rpx rgba(0,0,0,0.4), inset 0 0 16rpx rgba(0,0,0,0.5);
  overflow: hidden;
}
.bid-cell {
  flex: 1; min-width: 0;
  display: flex; align-items: center; justify-content: center; gap: 4rpx;
  border-right: 1rpx solid rgba(255,215,0,0.22);
  background: linear-gradient(180deg, #2c332a, #1b2119);
  color: #e8e8e0;
  position: relative;
  transition: all 0.25s;
}
.bid-cell:first-child { border-radius: 38rpx 0 0 38rpx; }
.bid-cell:last-child { border-right: none; border-radius: 0 38rpx 38rpx 0; }
.cell-label { font-size: 26rpx; font-weight: bold; line-height: 1; }
.cell-count {
  font-size: 18rpx; color: rgba(255,255,255,0.55);
  position: absolute; right: 8rpx; bottom: 8rpx;
}
.bid-cell.suit-heart .cell-label, .bid-cell.suit-diamond .cell-label { color: #ff8f85; }
.bid-cell.suit-spade .cell-label, .bid-cell.suit-club .cell-label { color: #cfd8e3; }
.bid-cell.suit-joker .cell-label { font-size: 22rpx; color: #fde68a; }
.bid-cell.dim { opacity: 0.42; }
.bid-cell.available {
  background: linear-gradient(180deg, #4a3b14, #2e2410);
  box-shadow: inset 0 0 12rpx rgba(255,190,60,0.5);
  animation: cellBreath 1.6s ease-in-out infinite;
}
.bid-cell.lit {
  background: linear-gradient(180deg, #ffe9a8, #e8a828);
  box-shadow: inset 0 0 10rpx rgba(255,255,255,0.6), 0 0 14rpx rgba(255,190,60,0.7);
}
.bid-cell.lit .cell-label { color: #5b3a00; }
.bid-cell.lit .cell-count { color: rgba(91,58,0,0.7); }
.bid-cell.clickable { cursor: pointer; }
.bid-cell.clickable:active { transform: scale(0.94); }

/* 常态横栏最左侧：不叫 / 不反主 */
.bid-cell.pass-cell {
  flex: 0 0 108rpx;
  background: linear-gradient(180deg, #4a2a20, #2a1813);
  border-right: 2rpx solid rgba(255,215,0,0.38);
}
.pass-cell .cell-label { font-size: 21rpx; color: #ffd9a0; }

/* 展开态：点花色后，同一条横栏内选亮主/分数/反主，不再有底部按钮栏 */
.action-head {
  flex: 0 0 118rpx;
  background: linear-gradient(180deg, #5b4512, #332709);
  border-right: 2rpx solid rgba(255,215,0,0.38);
}
.action-head .cell-label { font-size: 23rpx; color: #ffe9a8; }
.action-cell { flex: 1; }
.action-cell .cell-label { font-size: 24rpx; color: #fff2c9; }
.action-cell.primary { background: linear-gradient(180deg, #ffe9a8, #e8a828); }
.action-cell.primary .cell-label { color: #5b3a00; }
.action-cell.cancel { background: linear-gradient(180deg, #3a3f38, #23271f); }
.action-cell.cancel .cell-label { font-size: 21rpx; color: #c9cfc4; }

@keyframes cellBreath {
  0%, 100% { box-shadow: inset 0 0 8rpx rgba(255,190,60,0.35); }
  50% { box-shadow: inset 0 0 18rpx rgba(255,190,60,0.8); }
}

/* 中央出牌区（四方位） */
.trick-zone {
  position: absolute;
  top: 52%; left: 50%;
  transform: translate(-50%, -42%);
  width: 480rpx; height: 320rpx;
  z-index: 4;
  pointer-events: none;
}
.table-mark {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 168rpx; height: 168rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(255, 215, 0, 0.38);
  background: rgba(0,0,0,0.12);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 4rpx;
}
.mark-mode { font-size: 20rpx; color: rgba(255,255,255,0.6); letter-spacing: 3rpx; }
.mark-level { font-size: 34rpx; font-weight: bold; color: #ffe9a8; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.6); }
.mark-trump { font-size: 20rpx; color: rgba(255,255,255,0.75); }

.trick-pos { position: absolute; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.pos-top { top: 0; left: 50%; transform: translateX(-50%); }
.pos-bottom { bottom: 0; left: 50%; transform: translateX(-50%); }
.pos-left { left: 0; top: 50%; transform: translateY(-50%); }
.pos-right { right: 0; top: 50%; transform: translateY(-50%); }
.played-card {
  width: 86rpx; height: 122rpx;
  border-radius: 10rpx;
  background: linear-gradient(180deg, #fffef8, #f0ebdc);
  border: 2rpx solid rgba(120, 95, 45, 0.45);
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.45);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  color: #1f2937;
}
.played-card.red { color: #d0342c; }
.played-rank { font-size: 40rpx; font-weight: 900; line-height: 44rpx; }
.played-suit { font-size: 28rpx; line-height: 30rpx; }
.played-owner {
  font-size: 16rpx; color: #fff;
  background: rgba(0,0,0,0.55);
  padding: 2rpx 10rpx; border-radius: 12rpx;
  max-width: 150rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.state-hint {
  position: absolute; bottom: 14rpx; left: 50%;
  transform: translateX(-50%);
  font-size: 22rpx; color: #fff8dc;
  background: rgba(0,0,0,0.5);
  padding: 8rpx 28rpx; border-radius: 24rpx;
  border: 1rpx solid rgba(255,215,0,0.25);
  z-index: 5;
  max-width: 90%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.state-hint.dealing {
  color: #ffe9a8;
  background: rgba(44,28,0,0.78);
  border-color: rgba(255,215,0,0.6);
  font-weight: bold;
}

/* 中央浮层（反牌倒计时；发牌不再用浮层，避免遮挡亮主横栏） */
.center-overlay {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  z-index: 12;   /* 低于亮主横栏(25)，倒计时期间也能点横栏反主 */
}

/* 反牌倒计时小条：只占角落，绝不用大卡片遮住牌桌与自家手牌 */
.reverse-chip {
  position: absolute;
  top: 8rpx; left: 12rpx;   /* 靠左：避开右上角主牌徽标 */
  z-index: 14;
  display: flex; align-items: center; gap: 10rpx;
  padding: 6rpx 14rpx;
  border-radius: 24rpx;
  background: rgba(6, 26, 15, 0.88);
  border: 1rpx solid rgba(255, 215, 0, 0.5);
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.42);
}
.reverse-chip-num { font-size: 24rpx; font-weight: bold; color: #ffd700; }
.reverse-chip-txt { font-size: 18rpx; color: rgba(255,255,255,0.88); }
.reverse-chip-btn {
  font-size: 18rpx; font-weight: bold; color: #4a2c00;
  padding: 4rpx 14rpx; border-radius: 18rpx;
  background: linear-gradient(135deg, #ffd97a, #e8a32b);
}
.overlay-card {
  width: 420rpx;
  padding: 30rpx 28rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: rgba(8, 32, 20, 0.94);
  border: 2rpx solid rgba(255, 215, 0, 0.55);
  box-shadow: 0 14rpx 40rpx rgba(0,0,0,0.6), inset 0 0 24rpx rgba(255,215,0,0.08);
  display: flex; flex-direction: column; align-items: center; gap: 16rpx;
}
.overlay-title { font-size: 30rpx; font-weight: bold; color: #ffe9a8; letter-spacing: 2rpx; }
.overlay-hint { font-size: 22rpx; color: rgba(255,255,255,0.85); }
.overlay-tip { font-size: 20rpx; color: #ffd700; }
.overlay-ring {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: linear-gradient(135deg, #ffd97a, #e08a2e);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 0 22rpx rgba(255,190,60,0.6);
}
.overlay-ring text {
  width: 78rpx; height: 78rpx; border-radius: 50%;
  background: #0d2a1a; color: #ffd97a;
  font-size: 40rpx; font-weight: bold;
  display: flex; align-items: center; justify-content: center;
}
.overlay-btn {
  margin: 6rpx 0 0; padding: 0 32rpx;
  height: 62rpx; line-height: 62rpx;
  font-size: 24rpx; font-weight: bold; color: #4a2c00;
  border-radius: 32rpx; border: none;
  background: linear-gradient(135deg, #ffd97a, #eda32b);
}
.dealing-spinner {
  width: 56rpx; height: 56rpx;
  border: 6rpx solid rgba(255,255,255,0.18);
  border-top-color: #ffd54a;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}
.deal-progress {
  position: absolute; bottom: 2rpx; left: 50%;
  transform: translateX(-50%);
  width: 300rpx; height: 8rpx; border-radius: 8rpx;
  background: rgba(255,255,255,0.14); overflow: hidden;
  z-index: 5;
}
.deal-progress-fill {
  height: 100%; border-radius: 8rpx;
  background: linear-gradient(90deg, #ffd97a, #e08a2e);
  transition: width 0.3s;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ---------- 第三行：自己信息 + 操作按钮 ---------- */
.dock {
  position: relative;
  z-index: 8;
  flex: 0 0 96rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  gap: 12rpx;
  background: linear-gradient(180deg, rgba(0,0,0,0.28), rgba(0,0,0,0.5));
}
.my-badge {
  position: relative;
  display: flex; align-items: center; gap: 10rpx;
  flex-shrink: 0;
  background: rgba(0,0,0,0.5);
  border: 1.5rpx solid rgba(255,215,0,0.4);
  border-radius: 30rpx;
  padding: 6rpx 16rpx 6rpx 6rpx;
}
.my-badge.banker { border-color: #ffb300; box-shadow: 0 0 16rpx rgba(255,180,0,0.55); }
.my-face {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  background: linear-gradient(135deg, #fcd34d, #b45309);
  color: #fff; font-size: 24rpx; font-weight: bold;
  display: flex; align-items: center; justify-content: center;
  border: 2rpx solid rgba(255,255,255,0.5);
}
.my-meta { display: flex; flex-direction: column; }
.my-name { font-size: 20rpx; color: #ffe9a8; font-weight: bold; line-height: 1.25; }
.my-count { font-size: 17rpx; color: rgba(255,255,255,0.75); line-height: 1.25; }
.action-bar {
  flex: 1; min-width: 0;
  display: flex; align-items: center; justify-content: flex-end;
  gap: 10rpx;
}
.dock-tip {
  flex: 1; min-width: 0;
  text-align: right;
  font-size: 19rpx; color: rgba(255,233,168,0.78);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.op-btn {
  margin: 0; padding: 0;
  width: 98rpx; height: 60rpx; line-height: 60rpx;
  font-size: 23rpx; color: #fff;
  border-radius: 30rpx; border: 1rpx solid rgba(255,255,255,0.28);
  background: rgba(255,255,255,0.16);
  flex-shrink: 0;
  box-shadow: 0 3rpx 8rpx rgba(0,0,0,0.3);
}
.op-btn.primary {
  color: #4a2c00; font-weight: bold; border: none;
  background: linear-gradient(135deg, #ffd97a, #e8a32b);
  box-shadow: 0 4rpx 14rpx rgba(232,163,43,0.5);
}

/* ---------- 第四行：手牌区 ---------- */
.hand-area {
  position: relative;
  z-index: 50;        /* 手牌常驻最高层：任何倒计时/浮层都压不住自家展开的牌 */
  flex: 0 0 216rpx;
  width: 100%;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(10, 34, 20, 0.86), rgba(3, 14, 8, 0.96));
  border-top: 2rpx solid rgba(255, 215, 0, 0.4);
  box-shadow: 0 -8rpx 24rpx rgba(0,0,0,0.35);
}
.hand-scroll { width: 100%; height: 100%; }
.hand-cards {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  height: 100%;
  box-sizing: border-box;
  padding: 34rpx 36rpx 20rpx;
}
.hand-edge {
  position: absolute; top: 0; right: 0; bottom: 0; width: 36rpx;
  background: linear-gradient(90deg, rgba(3,14,8,0), rgba(3,14,8,0.85));
  pointer-events: none;
}

/* 单张牌：比旧版大 3 倍，左上角标清晰可读 */
.hand-card {
  position: relative;
  width: 100rpx; height: 156rpx;
  flex-shrink: 0;
  margin-right: -60rpx;          /* 露出 40rpx，组间再留白 */
  border-radius: 10rpx;
  background: linear-gradient(180deg, #fffef9, #f1ecdd);
  border: 1.5rpx solid rgba(110, 88, 45, 0.42);
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.4), inset 0 0 0 2rpx rgba(255,255,255,0.7);
  color: #1f2937;
  overflow: hidden;
  z-index: 1;
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}
.hand-card.red { color: #d0342c; }
.hand-card.group-start { margin-left: 26rpx; }
.card-corner {
  position: absolute; top: 7rpx; left: 6rpx;
  display: flex; flex-direction: column; align-items: center;
  line-height: 1;
}
.corner-rank { font-size: 28rpx; font-weight: 900; line-height: 30rpx; }
.corner-suit { font-size: 22rpx; line-height: 24rpx; margin-top: 2rpx; }
.card-big {
  position: absolute; left: 5rpx; top: 66rpx;
  font-size: 38rpx; line-height: 42rpx;
  opacity: 0.88; font-weight: bold;
}
.hand-card.joker .corner-rank { font-size: 24rpx; }
.hand-card.joker .card-big { font-size: 30rpx; top: 72rpx; }
.hand-card.selected {
  transform: translateY(-30rpx);
  border: 3rpx solid #ffd54a;
  box-shadow: 0 8rpx 20rpx rgba(255,200,60,0.65), 0 0 0 2rpx rgba(255,255,255,0.5);
  z-index: 30;
}
.hand-card.dealing-in { animation: dealFlyIn 0.45s ease-out backwards; }
@keyframes dealFlyIn {
  0% { transform: translateY(-420rpx) translateX(-40rpx) scale(0.5) rotate(-12deg); opacity: 0; }
  60% { opacity: 1; }
  100% { transform: translateY(0) translateX(0) scale(1) rotate(0deg); opacity: 1; }
}

/* ================= 断线遮罩 ================= */
.lock-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.72);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  color: #fff; font-size: 28rpx; z-index: 100;
}
.lock-spinner {
  width: 52rpx; height: 52rpx;
  border: 5rpx solid rgba(255,255,255,0.2);
  border-top-color: #ffd54a;
  border-radius: 50%; animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

/* ==========================================================================
   横屏适配（进入牌桌自动横屏）
   横屏时 750rpx = 屏幕长边，可用高度只有约 320~420rpx，
   因此所有区块改用「按高度百分比」分配，元素尺寸同步缩小一档。
   ========================================================================== */
@media (min-width: 500px) {
  .status-bar { flex: 0 0 5%; padding: 0 12rpx; gap: 8rpx; }
  .back-btn, .help-btn, .piggy-icon { width: 28rpx; height: 28rpx; font-size: 20rpx; border-radius: 7rpx; }
  .back-btn { font-size: 28rpx; line-height: 24rpx; }
  .room-chip { font-size: 14rpx; padding: 2rpx 10rpx; }

  /* 大厅 */
  .table-title { font-size: 32rpx; letter-spacing: 5rpx; margin-bottom: 8rpx; }
  .table-center { height: 62vh; max-height: none; border-radius: 26rpx; }
  .seat-avatar { width: 50rpx; height: 50rpx; border-radius: 14rpx; }
  .avatar-letter { font-size: 24rpx; }
  .seat-name { font-size: 16rpx; max-width: 110rpx; }
  .seat-status, .seat-cards { font-size: 13rpx; }
  .center-buttons { margin-top: 10rpx; gap: 14rpx; }
  .action-btn { width: 170rpx; height: 52rpx; line-height: 52rpx; font-size: 22rpx; }
  .lobby-hint { margin-top: 8rpx; font-size: 16rpx; padding: 4rpx 18rpx; }
  /* 横屏按钮栏：压扁成一条，不与牌桌/手牌抢高度 */
  .seat-toolbar { margin-top: 8rpx; gap: 8rpx; }
  .seat-tool-btn { min-width: 80rpx; height: 40rpx; line-height: 40rpx; padding: 0 14rpx; font-size: 18rpx; border-radius: 20rpx; }
  .seat-toolbar.compact { gap: 4rpx; }
  .seat-toolbar.compact .seat-tool-btn { height: 30rpx; line-height: 30rpx; padding: 0 9rpx; font-size: 14rpx; border-radius: 15rpx; }

  /* 牌桌分区：全部按高度百分比，避免横屏下溢出 */
  .game-stage { overflow: hidden; }
  .felt { top: 52rpx; bottom: 128rpx; left: 10rpx; right: 10rpx; border-radius: 28rpx; }

  .hud-zone { flex: 0 0 15%; }
  .score-board { left: 10rpx; top: 2rpx; width: 210rpx; padding: 2rpx 8rpx; border-radius: 9rpx; }
  .score-row { height: 20rpx; gap: 6rpx; }
  .score-team { font-size: 15rpx; width: 36rpx; }
  .score-level { font-size: 18rpx; width: 24rpx; }
  .score-label { font-size: 13rpx; }
  .score-point { font-size: 16rpx; }
  .level-card { width: 66rpx; height: 48rpx; top: 1rpx; border-width: 2rpx; border-radius: 9rpx; }
  .level-num { font-size: 30rpx; line-height: 32rpx; }
  .level-cap { font-size: 10rpx; }
  .trump-badge { right: 10rpx; top: 3rpx; padding: 2rpx 10rpx; border-radius: 9rpx; }
  .trump-badge-label { font-size: 12rpx; }
  .trump-badge-char { font-size: 18rpx; line-height: 19rpx; }
  .trump-badge-char.none { font-size: 14rpx; }
  .trump-badge-value { font-size: 16rpx; }

  /* 横屏纵向空间紧张：牌桌改为自上而下流式分区，杜绝元素互相压叠 */
  .table-zone { display: flex; flex-direction: column; align-items: center; }
  .pseat { width: 158rpx; height: 40rpx; padding: 4rpx 7rpx; gap: 6rpx; border-radius: 10rpx; }
  .pseat-top { position: relative; top: auto; left: auto; transform: none; margin-top: 2rpx; flex-shrink: 0; }
  .pseat-left { top: 30%; left: 8rpx; }
  .pseat-right { top: 30%; right: 8rpx; }
  .pseat-face { width: 30rpx; height: 30rpx; border-radius: 7rpx; font-size: 15rpx; border-width: 1rpx; }
  .pseat-nick { font-size: 13rpx; }
  .pseat-sub { gap: 5rpx; }
  .pseat-count { font-size: 12rpx; }
  .mini-backs { height: 12rpx; }
  .mini-back { width: 9rpx; height: 12rpx; margin-right: -5rpx; }
  .pseat-bid { min-width: 20rpx; height: 20rpx; font-size: 12rpx; top: -9rpx; right: 4rpx; }
  .pseat-banker { min-width: 16rpx; height: 16rpx; font-size: 11rpx; left: -6rpx; top: -7rpx; padding: 0 3rpx; }
  .state-hint.dealing { font-size: 12rpx; padding: 2rpx 12rpx; }
  .deal-progress { display: none; }

  .bid-zone { position: relative; top: auto; left: auto; transform: none; width: 420rpx; margin-top: 3rpx; flex-shrink: 0; }
  .bid-banner { height: 18rpx; gap: 8rpx; margin-bottom: 2rpx; }
  .bid-tag { font-size: 12rpx; padding: 1rpx 10rpx; }
  .bid-caption { font-size: 14rpx; max-width: 320rpx; }
  .bid-strip { height: 36rpx; padding: 2rpx; border-width: 2rpx; }
  .cell-label { font-size: 15rpx; }
  .cell-count { font-size: 11rpx; right: 5rpx; bottom: 2rpx; }
  .bid-cell.suit-joker .cell-label { font-size: 11rpx; letter-spacing: -1rpx; }
  .bid-cell.suit-joker .cell-count { display: none; }
  .bid-cell.pass-cell { flex: 0 0 62rpx; }
  .pass-cell .cell-label { font-size: 11rpx; }
  .action-head { flex: 0 0 66rpx; }
  .action-head .cell-label { font-size: 12rpx; }
  .action-cell .cell-label { font-size: 13rpx; }
  .action-cell.cancel .cell-label { font-size: 12rpx; }
  .dock-tip { font-size: 12rpx; }

  /* 出牌区横排：横屏高度有限，四方位绝对定位会互相压叠 */
  .trick-zone {
    position: relative; top: auto; left: auto; transform: none;
    width: 340rpx; height: auto; flex: 1; min-height: 0;
    display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 8rpx;
  }
  .trick-pos { position: relative; top: auto; left: auto; right: auto; bottom: auto; transform: none; }
  .table-mark { display: none; }
  .played-card { width: 40rpx; height: 54rpx; border-radius: 6rpx; }
  .played-rank { font-size: 22rpx; line-height: 24rpx; }
  .played-suit { font-size: 15rpx; line-height: 16rpx; }
  .played-owner { font-size: 11rpx; padding: 1rpx 6rpx; max-width: 80rpx; }
  .state-hint { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); font-size: 13rpx; padding: 2rpx 14rpx; }
  /* 座位卡片改单行：昵称 + 牌数并排，避免矮卡片里文字溢出 */
  .pseat-body { flex-direction: row; align-items: center; gap: 6rpx; }
  .pseat-nick { max-width: 96rpx; }
  .mini-backs { display: none; }
  .played-owner { display: none; }

  .overlay-card { width: 300rpx; padding: 14rpx 18rpx; gap: 8rpx; border-radius: 18rpx; }
  .overlay-title { font-size: 20rpx; }
  .overlay-hint, .overlay-tip { font-size: 14rpx; }
  .overlay-ring { width: 58rpx; height: 58rpx; }
  .overlay-ring text { width: 46rpx; height: 46rpx; font-size: 26rpx; }
  .overlay-btn { height: 42rpx; line-height: 42rpx; font-size: 16rpx; border-radius: 22rpx; padding: 0 24rpx; }
  .reverse-chip { top: 3rpx; left: 6rpx; padding: 2rpx 8rpx; gap: 5rpx; }
  .reverse-chip-num { font-size: 14rpx; }
  .reverse-chip-txt { font-size: 11rpx; }
  .reverse-chip-btn { font-size: 11rpx; padding: 2rpx 8rpx; border-radius: 10rpx; }
  .dealing-spinner { width: 34rpx; height: 34rpx; border-width: 4rpx; }
  .deal-progress { height: 8rpx; }

  .dock { flex: 0 0 10%; padding: 0 12rpx; gap: 8rpx; }
  .my-badge { padding: 3rpx 10rpx 3rpx 3rpx; gap: 6rpx; }
  .my-face { width: 34rpx; height: 34rpx; font-size: 16rpx; }
  .my-name { font-size: 14rpx; }
  .my-count { font-size: 12rpx; }
  .action-bar { gap: 7rpx; }
  .op-btn { width: 76rpx; height: 34rpx; line-height: 34rpx; font-size: 15rpx; border-radius: 17rpx; }

  /* 手牌：横屏宽度富余，25 张基本一屏排开，无需横向滚动 */
  .hand-area { flex: 0 0 23%; border-top-width: 1rpx; }
  .hand-cards {
    width: max-content !important;
    min-width: 100%;
    padding: 11rpx 12rpx 3rpx;
  }
  .hand-card {
    width: 44rpx;
    height: 100%;          /* 随手牌区高度自适应，横屏不会溢出 */
    margin-right: -18rpx;  /* 露出 26rpx */
    border-radius: 6rpx;
    border-width: 1rpx;
  }
  .hand-card.group-start { margin-left: 8rpx; }
  .card-corner { top: 3rpx; left: 3rpx; }
  .corner-rank { font-size: 16rpx; line-height: 17rpx; }
  .corner-suit { font-size: 12rpx; line-height: 13rpx; margin-top: 1rpx; }
  .card-big { left: 3rpx; top: 28rpx; font-size: 19rpx; line-height: 21rpx; }
  .hand-card.joker .corner-rank { font-size: 14rpx; }
  .hand-card.joker .card-big { font-size: 15rpx; top: 30rpx; }
  .hand-card.selected { transform: translateY(-10rpx); border-width: 2rpx; }
  .hand-edge { width: 20rpx; }
}
