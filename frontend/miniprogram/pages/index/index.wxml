<view class="container">
  <view class="title-area">
    <text class="title">升级</text>
    <text class="subtitle">四人在线对战</text>
  </view>

  <!-- 未连接状态：必须在这里就能改服务器地址，否则真机连不上时无法填局域网 IP（死锁） -->
  <view class="section" wx:if="{{!connected}}">
    <view class="status-text">{{connectFailed ? '连接失败，请检查服务器地址' : '正在连接服务器...'}}</view>
    <view class="server-row">
      <input class="server-input" placeholder="ws://192.168.x.x:8888" value="{{serverUrlInput}}" bindinput="onServerUrlInput" />
      <button class="server-apply" bindtap="onApplyServerUrl">切换</button>
    </view>
    <view class="server-hint">真机调试：电脑先运行 start-backend.cmd，手机连同一 WiFi，这里填电脑局域网 IP（如 ws://192.168.1.5:8888）。模拟器测试留空即可。</view>
    <view class="server-hint">当前尝试：{{serverUrl}}</view>
  </view>

  <!-- 已连接 - 房间大厅 -->
  <view class="lobby" wx:if="{{connected}}">
    <view class="lobby-card">
      <view class="card-header">
        <text class="card-title">在线房间</text>
        <view class="header-right">
          <text class="room-count">共 {{roomList.length}} 间</text>
          <view class="refresh-btn {{refreshing ? 'spinning' : ''}}" wx:if="{{!inRoom}}" bindtap="onRefreshRooms">
            <text class="refresh-icon">↻</text>
          </view>
        </view>
      </view>

      <!-- 微信头像/昵称同步（进入大厅即可设置，房间内实时同步给所有人） -->
      <view class="profile-sync">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{myAvatar}}" src="{{myAvatar}}" class="avatar-img" mode="aspectFill"></image>
          <view wx:else class="avatar-placeholder">＋</view>
        </button>
        <input class="nickname-input" type="nickname" placeholder="点击同步微信昵称" value="{{myNickname}}" bindblur="onNicknameInput" bindinput="onNicknameInput" />
      </view>

      <!-- 服务器地址：默认本机 8888；真机调试改成电脑局域网 IP -->
      <view class="server-row" wx:if="{{!inRoom}}">
        <input class="server-input" placeholder="ws://localhost:8888" value="{{serverUrlInput}}" bindinput="onServerUrlInput" />
        <button class="server-apply" bindtap="onApplyServerUrl">切换</button>
      </view>
      <view class="server-hint" wx:if="{{!inRoom}}">当前：{{serverUrl}}（真机填局域网IP，留空恢复默认）</view>

      <button class="btn btn-create" bindtap="onCreateRoom" wx:if="{{!inRoom}}">
        <text class="btn-icon">+</text>
        <text>创建房间</text>
      </button>

      <!-- 邀请好友按钮（在房间内显示） -->
      <button class="btn btn-invite" wx:if="{{inRoom}}" bindtap="onInviteFriends">
          <text class="btn-icon">👥</text>
          <text>邀请好友</text>
        </button>
      <view class="join-section" wx:if="{{!inRoom}}">
        <input class="input-room-id" placeholder="输入房间号" value="{{joinRoomId}}" bindinput="onJoinRoomIdInput" />
        <button class="btn btn-join" bindtap="onJoinRoom" disabled="{{!joinRoomId}}">加入房间</button>
      </view>

      <view class="room-list" wx:if="{{roomList.length > 0 && !inRoom}}">
        <view class="room-item" wx:for="{{roomList}}" wx:key="id" bindtap="onJoinRoomById" data-room="{{item}}">
          <view class="room-info">
            <text class="room-name">房间 {{item.id}}</text>
            <text class="room-players">{{item.playerCount}}/{{item.maxPlayers}} 人</text>
          </view>
          <view class="room-status {{item.playerCount >= item.maxPlayers ? 'full' : 'open'}}">
            {{item.playerCount >= item.maxPlayers ? '已满' : '可加入'}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 在房间内 -->
  <view class="in-room" wx:if="{{inRoom}}">
    <view class="room-panel">
      <view class="room-header">
        <text class="room-id">房间 {{currentRoomId}}</text>
        <text class="player-count">{{roomPlayerCount}}/4 人</text>
      </view>

      <!-- 固定四个座位：坐满/未坐满都在同一屏显示 -->
      <view class="player-list">
        <view class="player-item {{item.isSelf ? 'self' : ''}} {{item.empty ? 'empty' : ''}}" wx:for="{{roomSeats}}" wx:key="seatNo">
          <image class="player-avatar-img" wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill"></image>
          <view class="player-avatar" wx:elif="{{!item.empty}}">{{item.initial || item.seatNo}}</view>
          <view class="player-avatar empty-avatar" wx:else>{{item.seatNo}}</view>
          <view class="player-info">
            <text class="player-name">{{item.empty ? '等待玩家加入…' : (item.nickname || item.name)}}{{item.isSelf ? '（我）' : ''}}</text>
            <text class="player-ready {{item.ready ? 'ready' : ''}}">{{item.empty ? '空位' : (item.ready ? '已准备' : '等待')}}</text>
          </view>
        </view>
      </view>

      <view class="action-area">
        <button class="btn btn-ready {{selfReady ? 'ready-btn' : ''}}" bindtap="onToggleReady">
          {{selfReady ? '已准备' : '准备'}}
        </button>
        <button class="btn btn-start" bindtap="onStartGame" wx:if="{{allReady}}">
          开始游戏
        </button>
        <button class="btn btn-leave" bindtap="onLeaveRoom">
          退出房间
        </button>
      </view>

      <view class="waiting-hint" wx:if="{{autoStarting}}">
        <text>四人已准备，正在自动开局发牌…</text>
      </view>
      <view class="waiting-hint" wx:elif="{{roomPlayerCount < 4}}">
        <text>等待其他玩家加入（{{roomPlayerCount}}/4）...</text>
      </view>
      <view class="waiting-hint" wx:elif="{{!allReady}}">
        <text>等待所有人准备...</text>
      </view>
    </view>
  </view>

  <!-- 底部区域 - 仅在未进入房间时显示 -->
  <view class="bottom-area" wx:if="{{!inRoom}}">
    <view class="background-overlay">
      <image src="../../images/table-bg-bottom.webp" class="bg-image" mode="aspectFill"></image>
      <view class="bg-blend"></view>
    </view>
    
    <view class="content-overlay">
      <view class="info">
        <text>双升 · 拖拉机 · 升级</text>
        <text class="version">v1.0 在线版</text>
      </view>
      
      <button class="btn btn-rules" bindtap="onRules">
        <text class="btn-icon">📖</text>
        <text>游戏规则</text>
      </button>
    </view>
  </view>
</view>
