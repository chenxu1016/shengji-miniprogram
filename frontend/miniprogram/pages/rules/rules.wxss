.rules-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #1a3a2a;
}

.rules-scroll {
  flex: 1;
  padding: 40rpx 32rpx;
}

.rules-content {
  padding-bottom: 60rpx;
}

.rules-title {
  display: block;
  text-align: center;
  font-size: 52rpx;
  font-weight: bold;
  color: #ffd700;
  margin-bottom: 40rpx;
  text-shadow: 2rpx 2rpx 8rpx rgba(0,0,0,0.4);
}

.rule-section {
  margin-bottom: 32rpx;
  background: rgba(0,0,0,0.55);
  border: 1rpx solid rgba(255,215,0,0.15);
  border-radius: 20rpx;
  padding: 28rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #ffd700;
  margin-bottom: 16rpx;
}

.rule-text {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.92);
  line-height: 1.8;
  margin-bottom: 8rpx;
}
